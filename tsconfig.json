{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@narok/data": ["./packages/data/src/index.ts"],
      "@narok/sim": ["./packages/sim/src/index.ts"],
      "@narok/protocol": ["./packages/protocol/src/index.ts"],
      "@narok/loot": ["./packages/loot/src/index.ts"],
      "@narok/progression": ["./packages/progression/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tools/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ],
  "exclude": ["**/node_modules/**", "**/artifacts/**"]
}
